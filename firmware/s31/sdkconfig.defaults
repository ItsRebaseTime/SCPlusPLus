# ESP32-S31 Function-CoreBoard-1 — NimBLE host, peripheral role only.
#
# Unlike the S3 build (sdkconfig.defaults at repo root), this board's debug
# UART/JTOG live on a dedicated USB-C port separate from the USB-A host port
# the Steam Controller uses, so no console-routing workaround is needed here.
CONFIG_USB_OTG_SUPPORTED=y

# esp_ble_iso (pulled in transitively for LE Audio/ISO on the newer official
# ESP-IDF checkout) emits "#warning FreeRTOS with 1ms tick rate is strongly
# recommended for running ISO" at the default 100Hz/10ms tick, which this
# build's -Werror config turns fatal. Following the recommendation directly
# is also just correct for CIS/ISO timing precision, not merely a warning
# suppression.
CONFIG_FREERTOS_HZ=1000

# Real hardware bring-up (2026-08-15): the actual flash chip on this board is
# 16MB (confirmed via `esptool flash_id` -> device 0x4018, and the boot log's
# own "Detected size(16384k)" notice), but this was left at IDF's 2MB
# default — a real bug independent of the boot hang documented in BUILD.md's
# "Real hardware bring-up" section (fixing this did NOT resolve that hang,
# but a 2MB/16MB flash-size mismatch is wrong regardless and worth keeping
# fixed).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Dropped from the 80MHz default after the boot-hang investigation (see
# BUILD.md) traced the hang to inside esp_flash's app-level init, right
# after it falls back to a "generic" (unrecognized) flash-chip driver — on
# the theory that 80MHz DIO might exceed this specific, unrecognized chip's
# real signal margin. This did NOT fix the hang either, but 40MHz is a
# strictly safer choice for an unrecognized flash chip on unverified new
# hardware regardless, so left in place.
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Real hardware bring-up (2026-08-15): enabling CONFIG_BT_NIMBLE_ROLE_CENTRAL
# (see below) pulled in enough extra GATT-client code that the app overflowed
# the default 1MB single-app partition by ~88KB. The board's real flash is
# 16MB (see above), so there's no reason to stay on the small partition
# table — switch to IDF's built-in "large" single-app table (2MB) instead of
# hand-rolling a custom partitions.csv.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# Real hardware bring-up (2026-08-15): esp_ble_audio_common_init() (see the
# comment at its call site in le_audio_bap.c) pulls in NimBLE GATT-client
# code (esp_ble_iso/host/adapter/nimble/gatt/gatt.nrp.c calls
# ble_gattc_read/_by_uuid/_long, ble_gattc_write_flat/_no_rsp_flat) —
# confirmed via real "undefined reference" link errors with Central off.
# This app never actually scans or initiates connections (still peripheral-
# only in practice), but the GATT client *functions* need to be compiled
# into NimBLE's own host library for esp_ble_audio's internal cross-service
# discovery to link, which apparently needs Central role enabled to pull in.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# Observer role: this device never scans/connects as a GAP central, but the
# CIS/BIG ISO HCI event handler bodies (ble_hs_hci_evt_le_cis_estab et al —
# what "undefined reference" pointed at) are, in NimBLE's own upstream
# host/src/ble_hs_hci_evt.c, textually nested inside
# `#if MYNEWT_VAL(BLE_EXT_ADV) && NIMBLE_BLE_SCAN`, and
# NIMBLE_BLE_SCAN expands to (BLE_ROLE_CENTRAL || BLE_ROLE_OBSERVER)
# (nimble/nimble_opt_auto.h). Confirmed by direct preprocessor bisection,
# not guessed — with Observer off, that whole block (including the CIS
# handlers our BAP unicast server needs) was silently compiled out, leaving
# only forward declarations, hence "used but never defined" at link time.
# Observer is the minimal role satisfying this without adding actual GAP
# Central (connection-initiating) capability this device doesn't need.
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Device Information + Battery service helpers (services/dis, services/bas) —
# used for the DualSense Edge's manufacturer/PnP-ID and battery-level
# characteristics. The HID-over-GATT service itself is hand-rolled against
# the raw ble_gatt_svc_def API (see ds_edge_hid.cpp) since ble_svc_hid's
# generic report array has no app-level write/notify hook, which a fast-
# changing gamepad input stream needs.
CONFIG_BT_NIMBLE_BAS_SERVICE=y
CONFIG_BT_NIMBLE_DIS_SERVICE=y

# Required by espressif/esp_bt_audio's bundled NimBLE integration
# (bt_audio_host_nimble.c calls ble_gap_ext_adv_*/ble_gap_periodic_adv_*,
# which only exist when this is enabled) — confirmed via a real build
# attempt in Phase 0/3, not from documentation. Legacy ble_gap_adv_start()
# (used by ds_edge_hid.cpp for the DualSense HID) keeps working once this
# is on; verify that assumption doesn't break anything once both services
# share one NimBLE host.
CONFIG_BT_NIMBLE_EXT_ADV=y

# BAP Unicast Server (LE Audio). Confirmed (by reading components/bt/CMakeLists.txt
# and components/bt/esp_ble_audio/Kconfig*/*.in directly) that esp_bt_audio's
# LE Audio sources/headers — including esp_ble_audio_defs.h/esp_ble_audio_pacs_api.h/
# esp_ble_audio_bap_api.h that le_audio_bap.cpp includes — are ALL compiled
# conditionally on CONFIG_BT_AUDIO && CONFIG_BT_ISO; the Phase 0 "esp_bt_audio
# builds cleanly" result was building an empty shell without this set. Setting
# just this one option cascades (via Kconfig `select`) to BT_ISO_PERIPHERAL ->
# BT_ISO_UNICAST -> BT_ISO, and BT_ASCS -> BT_ASCS_ASE_SNK/SRC (default y once
# their MAX_COUNT Kconfig ints default > 0) -> BT_PAC_SNK/SRC + BT_AUDIO_RX/TX
# -> BT_AUDIO.
CONFIG_BT_BAP_UNICAST_SERVER=y

# esp_ble_audio/host/adapter/nimble/init.c static_asserts TOTAL_CCCDS_COUNT
# (computed from enabled ASCS ASE sink/source counts + PACS characteristics)
# against this. Default is 8; with BT_ASCS's default 2 sink + 2 source ASEs
# plus PACS's 6 CCCD-bearing characteristics plus the 6 reserved for other
# GATT services, the real requirement is 17 — bumped to 24 for headroom.
CONFIG_BT_NIMBLE_MAX_CCCDS=24

# The BT_ISO Kconfig cascade from BT_BAP_UNICAST_SERVER above only reaches
# the *host*-side ISO code. The *controller*-side BLE 5.2 ISO feature
# (porting_btdm/controller/ble/Kconfig.in) is a separate, independently
# defaulted-off option — without it, esp_hci_internal.h's ISO transport
# declarations (r_ble_hci_trans_hs_iso_tx etc., wrapped in #if
# CONFIG_BT_LE_ISO_SUPPORT) are compiled out, causing "implicit declaration"
# errors in NimBLE's own ble_hs_iso.c. Confirmed to exist and be selectable
# (not another missing-implementation gap) by reading the Kconfig directly.
CONFIG_BT_LE_ISO_SUPPORT=y

# NimBLE's default INFO log level logs every GATT procedure at the host
# stack level ("GATT procedure initiated: notify; att_handle=...") which,
# for a HID device notifying at controller polling rate, floods the
# console. Dropping to WARNING keeps connection/error-level NimBLE logs
# without the per-packet noise.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_LOG_LEVEL=2

# Real hardware bring-up (2026-08-15): bonding is now enabled (see
# le_audio_bap.c's sm_bonding=1 change) — without NVS persistence, bond keys
# only live in RAM and are lost on every reboot, forcing the host to re-pair
# each time instead of reconnecting to an already-trusted device.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Real hardware bring-up (2026-08-15): NimBLE's ble_svc_dis component gates
# each individual Device Information characteristic behind its own Kconfig
# option — PNP_ID defaults off, so ble_svc_dis_pnp_id_set() in
# le_audio_bap.c was silently a no-op: no PnP ID (0x2A50) characteristic
# ever got registered at all (confirmed via a real GATT discovery — DIS
# only exposed Model Number + IEEE regulatory data). BlueZ's hog_accept()
# reads the peer's vendor/product ID from exactly this characteristic to
# populate the kernel HID device's identity — without it, this device
# showed up as VID=0000/PID=0000 instead of Sony's real 054C:0DF2. That's
# not just cosmetic: distro udev rules (e.g. Steam's own
# 60-steam-input.rules, matching KERNELS=="*054C:0DF2*") grant proper
# uaccess permissions on the hidraw device specifically by VID:PID — with
# the wrong identity, hidraw stayed root-only, which is why WebHID
# (navigator.hid, used by sites like ds.daidr.me) showed an empty device
# picker despite the gamepad otherwise working end-to-end.
CONFIG_BT_NIMBLE_SVC_DIS_PNP_ID=y
